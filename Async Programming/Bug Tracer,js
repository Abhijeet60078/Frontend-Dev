function getBugs() {
  return new Promise((resolve, reject) => {
    setTimeout(() => {
      Math.random() < 0.3
        ? reject("API Error")
        : resolve(["UI glitch", "API timeout", "Login failure"]);
    }, 1000);
  });
}

getBugs()
  .then(bugs => console.table(bugs))
  .catch(err => console.log("Failed:", err));
